class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& temp) {
        stack<int>st;
           
        int n = temp.size();
        vector<int> ans(n, 0);
       
        for(int i=n-1;i>=0;i--){
            int a = temp[i];
           
            while(st.size()!=0 && temp[st.top()]<=a){
                st.pop();
               
               

            }
            if(st.size()!=0){
                ans[i]= st.top()-i  ;
               
            }
            
               
                
               
               
            
            st.push(i);
            
        }
        return ans;
        
    }
};
