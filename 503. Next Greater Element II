class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        stack<int>st;
        int n = nums.size();
        for(int i=n-2;i>=0;i--){
            st.push(nums[i]) ;
        }
        for(int i=n-1;i>=0;i--){
            int a = nums[i];
            while(st.size() !=0 && a>=st.top()){
                st.pop();
            }
            if(st.size()==0){
                nums[i]=-1;
            }
            else {
                nums[i]= st.top();
            }
            st.push(a);
        }
        return nums;
        
    }
};
